# Copy to .env and fill the values. Never commit .env. Never quote the values.
# On this PDI, glide.enable.password_policy is true. A password with no special
# character is accepted on create (HTTP 200) and then fails login with HTTP 401.
# Each service password needs a special character. ! - and _ are known to work.
SN_INSTANCE_URL=
SN_ADMIN_USER=
SN_ADMIN_PASSWORD=
SN_AGENT_USER=
SN_AGENT_PASSWORD=
SN_INCIDENT_USER=
SN_INCIDENT_PASSWORD=
SN_PROBLEM_USER=
SN_PROBLEM_PASSWORD=
SN_AUTHORITY_USER=
SN_AUTHORITY_PASSWORD=
XAI_API_KEY=
XAI_MODEL=
